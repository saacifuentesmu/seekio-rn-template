{
  "name": "SeekioRnTemplate",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "android:dev": "react-native run-android --mode=devDebug --appId=io.seekio.rntemplate.dev",
    "android:staging": "react-native run-android --mode=stagingDebug --appId=io.seekio.rntemplate.staging",
    "android:prod": "react-native run-android --mode=prodDebug --appId=io.seekio.rntemplate",
    "android:apk:dev": "cd android && ./gradlew assembleDevRelease",
    "android:apk:staging": "cd android && ./gradlew assembleStagingRelease",
    "android:apk:prod": "cd android && ./gradlew assembleProdRelease",
    "ios:dev": "react-native run-ios --scheme \"SeekioRnTemplate-Dev\"",
    "ios:staging": "react-native run-ios --scheme \"SeekioRnTemplate-Staging\"",
    "ios:prod": "react-native run-ios --scheme \"SeekioRnTemplate-Prod\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@notifee/react-native": "7.8.2",
    "@react-native-async-storage/async-storage": "1.24.0",
    "@react-native-community/geolocation": "3.3.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@sentry/react-native": "5.33.1",
    "@tanstack/query-async-storage-persister": "^5.51.21",
    "@tanstack/react-query": "^5.51.23",
    "@tanstack/react-query-persist-client": "^5.51.23",
    "axios": "^1.7.4",
    "i18next": "^23.13.0",
    "react": "18.2.0",
    "react-hook-form": "^7.52.2",
    "react-i18next": "^15.0.1",
    "react-native": "0.74.3",
    "react-native-axios-jwt": "^1.8.0",
    "react-native-ble-plx": "3.2.0",
    "react-native-config": "1.5.3",
    "react-native-gesture-handler": "2.18.1",
    "react-native-localize": "3.2.1",
    "react-native-maps": "1.18.0",
    "react-native-permissions": "4.1.5",
    "react-native-reanimated": "3.10.1",
    "react-native-safe-area-context": "4.10.9",
    "react-native-screens": "3.32.0",
    "react-native-sensitive-info": "5.5.8",
    "react-native-splash-screen": "3.3.0",
    "yup": "^1.4.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/babel-preset": "0.74.85",
    "@react-native/eslint-config": "0.74.85",
    "@react-native/metro-config": "0.74.85",
    "@react-native/typescript-config": "0.74.85",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.19.0",
    "eslint-plugin-import": "^2.29.1",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "18.2.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
